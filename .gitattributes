# Export rules for `git archive` only (release tarballs). tuteur doesn't read them: a repo
# that takes this one as a pattern gets the whole repository as a git submodule. README, CHANGELOG and docs/ are the
# methodology; the rest is this repo's own, including the patterns it takes in .patterns/.
/.gitattributes      export-ignore
/.claude/            export-ignore
/AGENTS.md           export-ignore
/knowledge-base.yaml export-ignore
/flake.nix           export-ignore
/flake.lock          export-ignore
/.patterns/          export-ignore
/.forgejo/           export-ignore
